
// use prisma-8

enum Role {
  STUDENT
  LECTURER
}

model User {
  id           String   @id @onCreate(uuid(7))
  fullName     String
  email        String   @unique
  passwordHash String
  department   String
  role         Role
  matricNo     String?  @unique
  staffId      String?  @unique
  sessions     Session[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @onCreate(now()) @onUpdate(now())

  @@rls
}

model Session {
  id        String    @id @onCreate(uuid(7))
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@rls
}
